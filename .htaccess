# vnav —— Apache 配置
#
# 目的只有两个：
#   1) 拦住 inc/ 与 data/ —— 里面是密码哈希和整个数据库
#   2) 顺手关掉目录列表，别让人翻出没引用的文件
#
# Nginx 不读这个文件，需要在站点配置里手写 deny（见部署说明.md）。

# ---------- 1. 禁止访问敏感目录 ----------
# inc/ 整目录挡死 —— 里面是 config.php，存着密码哈希。
# data/ 不能整目录挡：站点图标就放在 data/icons/ 下，挡住等于所有图标 404。
# 所以这里用负向断言，只放行 icons 这一层，其余（home.db 等）照样 404。
RedirectMatch 404 ^/inc/
RedirectMatch 404 ^/data/(?!icons/)

# ---------- 2. 关掉目录列表 ----------
Options -Indexes

# ---------- 3. 不让浏览器猜类型 ----------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://www.baidu.com https://www.bing.com https://www.google.com https://duckduckgo.com https://www.sogou.com https://www.so.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self'"
    Header set Strict-Transport-Security "max-age=31536000"
</IfModule>

# ---------- 4. 压缩（纯文本资源能小一半以上） ----------
# PHP 自己会压 HTML（见 inc/compress.php），这里主要管静态 CSS/JS。
# mod_deflate 见到已有 Content-Encoding 会自动跳过，不会重复压。
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
    # 老 IE6 的 bug：不声明 Vary 会被代理缓存串味
    Header append Vary Accept-Encoding
</IfModule>

# Brotli 比 gzip 再小 15~20%。需要 mod_brotli（Apache 2.4.26+），没有就静默跳过。
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain application/javascript application/json image/svg+xml
    BrotliCompressionQuality 5
</IfModule>

# ---------- 5. 缓存 ----------
# 资源都在 URL 上挂了 ?v=N，所以可以长缓存。php 一律不缓存（数据随时会变）。
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/png  "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType text/css   "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # 只有带 ?v= 的才是不可变资源；不带的话交给上面的 Expires
    <FilesMatch "\.(css|js|woff2|png|ico|svg|webp)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # html 与 php 绝不缓存，否则改了代码看不到效果
    <FilesMatch "\.(php|html)$">
        Header set Cache-Control "no-store, must-revalidate"
    </FilesMatch>
</IfModule>

# ---------- 6. 默认首页 ----------
DirectoryIndex index.php

# ---------- 8. 点文件一律不对外 ----------
# .release-token / .git/ / .env / .gitignore 这类以点开头的路径段，
# 默认就不该能从浏览器拿到。上面的 ^/inc/ 与 ^/data/ 只覆盖两个目录，
# 根目录下的点文件是另一条独立的暴露面。
# 例外：.well-known/ 必须放行（ACME 证书续签要往这里写挑战文件）。
RedirectMatch 404 ^/(?!\.well-known/)(?:.*/)?\.[^/]+

# ---------- 7. 兜底：把 .db / .md 这类不该被下载的文件挡掉 ----------
<FilesMatch "\.(db|db-wal|db-shm|md|sql|log)$">
    Require all denied
</FilesMatch>